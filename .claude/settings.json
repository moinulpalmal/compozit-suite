{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/architecture-sync.mjs\"",
                        "shell": "bash",
                        "timeout": 10,
                        "statusMessage": "Checking ARCHITECTURE.md sync"
                    }
                ]
            }
        ]
    }
}
