# =============================================================================
# Compozit Suite — LAN production template
# =============================================================================
#
# Copy to `.env` ON THE SERVER and fill in. `.env.production` and `.env` are
# both gitignored, so nothing here reaches the repository.
#
#   copy .env.production.example .env
#   php artisan key:generate
#   .\deploy.ps1
#
# The full server runbook is ARCHITECTURE.md §15.
#
# Every value below differs from `.env.example` for a reason. Do not copy the
# development file and edit it by eye — APP_DEBUG alone would expose the
# database credentials and full stack traces on any error page to everyone on
# the LAN.
# =============================================================================

APP_NAME="Compozit Suite"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# The server's own address. Users type this, and it is what Laravel builds
# absolute URLs from, so it must be the LAN IP and port — not localhost.
# Give the machine a static IP or a DHCP reservation first: if this changes you
# must edit it here and re-run `php artisan optimize`.
APP_URL=http://192.168.1.50:8787

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# `debug` on a live box fills the disk and leaks query bindings into the log.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=compozitsuite
# Strongly recommended: a MySQL user with rights on this schema only, not root.
DB_USERNAME=compozit
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must stay false. This deployment is plain HTTP; a secure-only cookie would
# never be sent, and every login would silently fail.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Nothing in the application sends mail yet. Point this at the office SMTP relay
# before enabling any feature that notifies anyone.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@compozit.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Bootstrap super administrator — config/admin.php
# -----------------------------------------------------------------------------
#
# `deploy.ps1` runs `php artisan admin:create-super`, which creates this account
# on a fresh database and does nothing on every deploy after that. Without it
# nobody can log in: a production deploy seeds roles and designations but no
# users, and the login identifier is the employee ID, not the email address.
#
# Sign in once with these, then change the password through Settings → Security.
# ADMIN_PASSWORD is only read at deploy time; blank it afterwards if you prefer,
# and the command will simply report the account already exists.
#
ADMIN_EMPLOYEE_ID=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional. Must match a designation name exactly, e.g. "Managing Director".
ADMIN_DESIGNATION=

# -----------------------------------------------------------------------------
# Database backups — config/backup.php
# -----------------------------------------------------------------------------
#
# Written nightly by the scheduler and once by `deploy.ps1` immediately before
# migrations run.
#
# Put BACKUP_PATH on a different physical drive from the database. A dump beside
# the data it protects survives a bad migration but not a failed disk.
#
BACKUP_PATH=D:\backups\compozit
BACKUP_RETENTION_DAYS=14
BACKUP_TIME=01:00

# mysqldump is not on the PATH under Laragon, so give the absolute path — and
# make it the client belonging to the MySQL version actually running. A dump
# taken by an older client against a newer server can be lossy.
# Find the running version with: SELECT VERSION();
BACKUP_MYSQLDUMP_PATH=C:\laragon\bin\mysql\mysql-9.6.0-winx64\bin\mysqldump.exe
